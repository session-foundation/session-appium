# this is a sample .env file. Copy it to .env, and edit the .env file to match your needs.

ANDROID_APK=/path/to/Downloads/session-android-universal.apk
IOS_APP_PATH_PREFIX=/path/to/Downloads/Session.app
EMULATOR_FULL_PATH=/path/to/Android/Sdk/emulator/emulator
APPIUM_ADB_FULL_PATH=/path/to/Android/sdk/platform-tools/adb

# --- Desktop (the `desktop` and `cross-platform` Playwright projects) ---
# Required for any test that opens a Desktop client. Points at a BUILT Session Desktop source
# checkout (the harness launches `<root>/app/ts/mains/main_node.js` with Electron), not a packaged
# binary — so the checkout must have been compiled first.
SESSION_DESKTOP_ROOT=/path/to/session-desktop
# USE_XVFB=1              # Linux headless: adds --ozone-platform=x11 and blanks WAYLAND_DISPLAY
# LOG_NODE_CONSOLE=1      # pipe Electron main-process console output into the test log
# LOG_BROWSER_CONSOLE=1   # pipe Electron renderer console output into the test log
# SOGS_ADMIN_SEED=<hex>   # only needed by the community admin (ban/unban) desktop tests

PRINT_TEST_LOGS='true'
PRINT_ONGOING_TEST_LOGS = 1
PRINT_FAILED_TEST_LOGS=1
PLAYWRIGHT_RETRIES_COUNT=0
PLAYWRIGHT_REPEAT_COUNT=0
# Parallel test workers, configured per-platform (selected via the PLATFORM env variable)
PLAYWRIGHT_WORKERS_COUNT_ANDROID=1
PLAYWRIGHT_WORKERS_COUNT_IOS=1
PLAYWRIGHT_WORKERS_COUNT_DESKTOP=1
UPDATE_BASELINES='false' # true auto-saves missing baseline screenshots
# --- Which Session network the whole run targets ---
# ONE switch for all three platforms. devnet/testnet avoid full mainnet onion-routing latency, the
# dominant cost of the slowest multi-device tests.
#
# SET IT EXPLICITLY. Unset does NOT mean "everything on mainnet" — each platform then falls back to
# its own default and they disagree: iOS mainnet, Desktop TESTNET (see LOCAL_DEVNET_SEED_URL below),
# Android whatever its APK variant was built for. A multi-platform run in that state is refused by
# global-setup rather than left to hang.
#
# The harness translates NETWORK_TARGET into whatever each client actually reads at launch:
#   iOS     - app launch arguments
#   Android - launch intent extras (needs a QA build; see QaLaunchConfig in Session_Android)
#   Desktop - LOCAL_DEVNET_SEED_URL, set for you (do NOT set it by hand alongside NETWORK_TARGET)
# A run refuses to start if the platforms end up on different networks, or if devnet is unreachable.
#
# For devnet, the seed node's oxend RPC is the ONLY value you provide. The pubkey, IP and both
# storage ports are discovered from it via get_n_service_nodes, so they cannot go stale — the devnet
# regenerates its keys on every rebuild, which used to silently break iOS only. Guide: docs/local-devnet.md.
# A bare host, host:port or http://host:port are all accepted; the port defaults to 1280.
# NETWORK_TARGET=devnet
# DEVNET_SEED_URL=http://10.0.0.1:1280     # "IP:RPC" column of any SN row in the devnet node table
#
# Desktop-only escape hatch, for runs that do NOT set NETWORK_TARGET. Unset means TESTNET, not
# mainnet: this harness always launches Desktop with a `test-integration-*` NODE_APP_INSTANCE, which
# trips the app's own testnet flag. Pin mainnet with https://seed2.getsession.org:4443.
# LOCAL_DEVNET_SEED_URL=http://10.0.0.1:1280
#
# --- The two optional services that live on the devnet's host ---
# On a devnet run BOTH ARE DISCOVERED FOR YOU (run/test/utils/devnet_services.ts), keyed off the
# service-node IP the devnet advertises — which is the address the app needs, since it reaches both
# over an onion request through the snodes. Everything below is therefore an override, not setup.
# Whatever is unreachable is reported and skipped, leaving the run on the remote community and the
# production file server: both are optimisations, so nothing here can fail a run.
#
# Optional local file server (speeds media tests). FILE_SERVER_ED_PUBKEY is the server's ED25519
# pubkey — take the "File server Ed25519 pubkey" line, NOT the "which is X25519" one:
#   docker compose logs fileserver | grep -i pubkey
# THIS ONE YOU DO HAVE TO SET to get the local file server, and nothing can check it for you: both
# forms are 64 hex characters, and the key is used inside the onion request, so the wrong one
# surfaces as a transfer failing mid-run rather than as a config error.
# FILE_SERVER_ED_PUBKEY=<64-char hex Ed25519 pubkey>
# FILE_SERVER_URL=http://10.0.0.1:8000     # only to override the discovered address
# FILE_SERVER_HOST=10.0.0.1                # if the file server is NOT on the devnet's host
# FILE_SERVER_PORT=8000
#
# Optional local community/SOGS (the Sesh-Net-Docker `sogs` container, published on :8080). Setting
# COMMUNITY_LINK points the community tests at local rooms instead of the remote
# test-chat.session.codes; leave it unset on a non-devnet run to use the remote communities.
# Discovery builds this link itself and verifies it first: it makes one signed request to the server,
# which only succeeds if the public_key in the link really is that server's — so a stale SOGS_PUBKEY
# is reported rather than baked into a link the app cannot use. Set SOGS_PUBKEY if your SOGS is not
# the local stack's (`docker compose logs sogs | grep -i 'server pubkey'`).
# COMMUNITY_LINK=http://10.0.0.1:8080/local-devnet-community?public_key=aa7c2b3bcd6433e52d6616356fcdba68668e8b506d84a3c7a1a196d63235a613
# COMMUNITY_NAME=Local Devnet Community
# COMMUNITY_ROOM=local-devnet-community
# SOGS_PUBKEY=<64-char hex X25519 server pubkey>
# SOGS_HOST=10.0.0.1                       # if the SOGS is NOT on the devnet's host
# SOGS_PORT=8080
#
# Optional local Pro backend (the Sesh-Net-Docker `pro-backend` container, published on :8090). Unlike
# the two above this is NOT an optimisation: with TEST_PRO_BACKEND set the clients have no fallback —
# session-desktop throws on every swarm poll when it can't reach one, so nothing is ever received. The
# harness therefore warns loudly if you ask for it and it isn't usable.
# Its address is discovered off the devnet IP; the signing key is not discoverable (no route exposes
# it, and it is generated per instance rather than baked like the SOGS/file-server keys), so read it
# from `docker logs sesh-net-pro-backend`:
#   Ed25519 signing pubkey : <this one>
#   X25519 onion pubkey    : derived from it by the client — do NOT set it anywhere
# TEST_PRO_BACKEND=1                       # the on/off switch. ANY non-empty value enables it, `0` too
# TEST_PRO_BACKEND_ED_PK=<64-char hex Ed25519 signing pubkey>
# TEST_PRO_BACKEND_URL=http://10.0.0.1:8090  # only to override the discovered address
# PRO_BACKEND_HOST=10.0.0.1                # if the Pro backend is NOT on the devnet's host
# PRO_BACKEND_PORT=8090

# With COMMUNITY_LINK set, each community test creates rooms of its own and deletes them afterwards,
# so concurrent runs (CI and a laptop, or two CI jobs) can't interfere. This needs nothing beyond the
# three vars above and SOGS_ADMIN_SEED: rooms are created and deleted over SOGS' own HTTP API, signed
# as that account, which has to be a global admin on the server (locally it is by default — see
# SOGS_ADMIN_SESSION_IDS in Sesh-Net-Docker/sogs/docker-compose.yml).
#
# Checked once at startup by listing rooms. If that doesn't work — SOGS unreachable, the account not a
# global admin, a server too old to have the endpoints — the run falls back to the shared rooms with a
# loud warning rather than failing, since that still tests everything, just without isolating
# concurrent runs. See docs/local-devnet.md.
